# Never serve a stale HTML shell after deploy. Revalidate at every request.
/*
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Surrogate-Control: no-store
  Pragma: no-cache
  Expires: 0

# Media aliases point to Supabase objects and must not become stale at the CDN.
/media/*
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Surrogate-Control: no-store

# Fingerprinted/static assets can remain immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
